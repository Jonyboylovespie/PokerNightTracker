# Flask session secret key. Generate a long random string for production.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-secret-key

# Initial admin password (only used when the database is first created)
ADMIN_PASSWORD=pokeradmin

# IANA timezone used for poker-night entry dates, e.g. America/New_York.
# Leave blank to use the system timezone.
TIMEZONE=America/New_York
